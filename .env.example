POSTGIS_HOST=host.docker.internal
POSTGIS_PORT=5432
POSTGIS_DB=gis
POSTGIS_USER=pmtiles_builder
POSTGIS_PASSWORD=change-me

# Default manual build target region. Override with --region when running.
REGION=iraq
APP_ENV=development
# Backward-compatible alias if APP_ENV is not set: ENVIRONMENT=development|staging|production
ENVIRONMENT=development
BUILD_LOCK_ID=932001

# Object storage. Leave S3_BUCKET empty for local-only output.
# S3_* aliases are preferred by the publishing scripts; AWS_* aliases are also
# accepted for compatibility with boto3 and existing CI environments.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
# Leave empty for local-only output. Set to pmtiles when testing MinIO.
S3_BUCKET=
S3_ENDPOINT_URL=http://minio:9000
S3_FORCE_PATH_STYLE=true
# Public CDN/object-storage URL written into manifests. In production this
# should be the CDN hostname that serves immutable PMTiles and manifests.
# For Windows/host validation of the local static service, use localhost:8088.
# For --verify-url inside docker compose, override this to http://static:80
# because localhost points to the pmtiles-builder container.
S3_PUBLIC_BASE_URL=http://localhost:8088

# Public base URL for files after upload. For local static testing:
# Use http://static:80 for docker-compose-internal --verify-url.
CDN_BASE_URL=http://localhost:8088

# Pipeline paths inside the container.
CONFIG_DIR=/app/config
OUTPUT_DIR=/app/output
TMP_DIR=/app/tmp
LOG_DIR=/app/logs

# Retention and local test defaults.
RETENTION_DAYS=30
STATIC_BASE_URL=http://localhost:8088
VERIFY_PUBLISHED_URL=false

API_HOST=0.0.0.0
API_PORT=8090
API_CORS_ORIGIN=*
MAP_INTERNAL_TOKEN=dev-internal-token
TRUSTED_GATEWAY_HEADER=
TRUSTED_GATEWAY_HEADER_VALUE=
MAP_STYLE=light
PUBLIC_DIRECT_TILE_ENDPOINTS=true
ALLOW_PUBLIC_DIRECT_TILES_IN_PRODUCTION=false
REQUIRE_REVERSE_PROXY=false
TRUSTED_PROXY_MODE=
PUBLIC_API_BASE_URL=
TILES_BEHIND_GATEWAY=false
STATIC_PUBLISH_ROOT=
STYLE_VALIDATE_MAX_BODY_BYTES=1048576

# Phase 1 single-server production example:
# APP_ENV=production
# TILES_BEHIND_GATEWAY=true
# API_CORS_ORIGIN=https://api.tavrix.com,https://app.tavrix.com
# MAP_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
# TRUSTED_GATEWAY_HEADER=X-Tavrix-Gateway-Token
# TRUSTED_GATEWAY_HEADER_VALUE=replace-with-at-least-32-random-characters
# PUBLIC_DIRECT_TILE_ENDPOINTS=false
# REQUIRE_REVERSE_PROXY=true
# TRUSTED_PROXY_MODE=standard
# PUBLIC_API_BASE_URL=https://api.tavrix.com/maps
# CDN_BASE_URL=https://tiles.tavrix.com
# S3_PUBLIC_BASE_URL=https://tiles.tavrix.com
# STATIC_BASE_URL=https://tiles.tavrix.com
# STATIC_PUBLISH_ROOT=/var/www/tavrix-tiles
# GLYPHS_URL=https://tiles.tavrix.com/fonts/{fontstack}/{range}.pbf
# SPRITES_BASE_URL=https://tiles.tavrix.com/sprites

# Glyphs are required for text labels. Production must set GLYPHS_URL explicitly
# to a production glyph endpoint. Use either an external CDN URL or the local
# API route after installing PBF ranges under config/glyphs/<fontstack>/.
#
# Development-only demo fallback, allowed with readiness warning when GLYPHS_URL
# is empty:
#   https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf
#
# Local hosting example:
#   /api/fonts/{fontstack}/{range}.pbf
GLYPHS_URL=/api/fonts/{fontstack}/{range}.pbf
LOCAL_GLYPHS_URL=/api/fonts/{fontstack}/{range}.pbf
GLYPHS_DIR=/app/config/glyphs
GLYPH_FONTSTACKS=Noto Sans Regular
GLYPH_READINESS_TIMEOUT_SECONDS=3
SPRITES_DIR=/app/config/sprites
SPRITES_BASE_URL=
