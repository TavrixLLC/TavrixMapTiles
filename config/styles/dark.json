{
  "version": 8,
  "name": "Dark",
  "glyphs": "{GLYPHS_URL}",
  "sources": {},
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "minzoom": 6,
      "paint": {
        "fill-color": [
          "match",
          ["get", "landuse_class"],
          "park",
          "#233d34",
          "garden",
          "#233d34",
          "grassland",
          "#2f4637",
          "wood",
          "#1d382c",
          "sand",
          "#3b3524",
          "desert",
          "#3b3524",
          "#1b2024"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "minzoom": 6,
      "paint": {
        "fill-color": "#163444",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "minzoom": 6,
      "paint": {
        "line-color": "#56636e",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 14, 1.0],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 6,
      "paint": {
        "line-color": "#0c0f12",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.1, 10, 2.2, 14, 6.4]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 6,
      "paint": {
        "line-color": [
          "match",
          ["get", "road_class"],
          "motorway",
          "#e17d57",
          "trunk",
          "#d8944f",
          "primary",
          "#d0b15b",
          "secondary",
          "#9d9e78",
          "#67737c"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.55, 10, 1.3, 14, 4.2]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#33404a",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "places",
      "minzoom": 6,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 18, 16, 22],
        "text-anchor": "center",
        "text-padding": 8
      },
      "paint": {
        "text-color": "#d8dee4",
        "text-halo-color": "#101418",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["any", ["has", "name"], ["has", "ref"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 13]
      },
      "paint": {
        "text-color": "#c3cbd2",
        "text-halo-color": "#101418",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "pois",
      "type": "circle",
      "source": "pois",
      "source-layer": "pois",
      "minzoom": 10,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 10, 2.5, 16, 7.0],
        "circle-color": [
          "match",
          ["get", "category"],
          "restaurant",
          "#ff7b64",
          "cafe",
          "#d19b69",
          "shop",
          "#8fb3ff",
          "hotel",
          "#b79cff",
          "fuel",
          "#73d6a5",
          "#d3dbe2"
        ],
        "circle-stroke-color": "#101418",
        "circle-stroke-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 16, 1.5],
        "circle-opacity": 0.9
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "pois",
      "source-layer": "pois",
      "minzoom": 15,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-offset": [0, 1.0],
        "text-anchor": "top",
        "text-padding": 4
      },
      "paint": {
        "text-color": "#d8dee4",
        "text-halo-color": "#101418",
        "text-halo-width": 1.2
      }
    }
  ]
}
