{
  "version": 8,
  "name": "Navigation",
  "glyphs": "{GLYPHS_URL}",
  "sources": {},
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ede9dd"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "minzoom": 6,
      "paint": {
        "fill-color": "#9ed1ed",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "minzoom": 8,
      "paint": {
        "fill-color": [
          "match",
          ["get", "landuse_class"],
          "park",
          "#c6e6b7",
          "garden",
          "#c6e6b7",
          "grassland",
          "#d4e8bf",
          "wood",
          "#abd3a3",
          "#ededdf"
        ],
        "fill-opacity": 0.55
      }
    },
    {
      "id": "minor-road-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": ["!", ["in", ["get", "road_class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]]],
      "paint": {
        "line-color": "#aab5b9",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1.3, 16, 5.6],
        "line-opacity": 0.75
      }
    },
    {
      "id": "minor-roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": ["!", ["in", ["get", "road_class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]]],
      "paint": {
        "line-color": "#fbfbf6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.75, 16, 4.4]
      }
    },
    {
      "id": "major-road-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 6,
      "filter": ["in", ["get", "road_class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "paint": {
        "line-color": "#fffdf7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.4, 10, 3.4, 16, 9.0]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 6,
      "filter": ["in", ["get", "road_class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "paint": {
        "line-color": [
          "match",
          ["get", "road_class"],
          "motorway",
          "#e05f3f",
          "trunk",
          "#e98932",
          "primary",
          "#ecbd42",
          "#d5c453"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 10, 2.0, 16, 6.4]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-color": "#b7a99c",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "places",
      "minzoom": 6,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 19, 16, 23],
        "text-padding": 8
      },
      "paint": {
        "text-color": "#222f3a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": ["any", ["has", "name"], ["has", "ref"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "ref"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 16, 14]
      },
      "paint": {
        "text-color": "#4f5961",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "pois",
      "type": "circle",
      "source": "pois",
      "source-layer": "pois",
      "minzoom": 12,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 12, 2.0, 16, 6.5],
        "circle-color": "#2f6fc2",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 1.2,
        "circle-opacity": 0.86
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "pois",
      "source-layer": "pois",
      "minzoom": 15,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-offset": [0, 1.0],
        "text-anchor": "top",
        "text-padding": 4
      },
      "paint": {
        "text-color": "#1f2933",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.25
      }
    }
  ]
}
